# 复制为 .env 后填写（.env 已被 git 忽略，勿提交）
# cp .env.example .env

# 蓝湖登录 Cookie（必填）
# 浏览器 DevTools → Network → 任意 lanhuapp.com 请求 → 复制 Cookie 请求头
LANHU_COOKIE=

# DDS 专用 Cookie（可选；不填则复用 LANHU_COOKIE）
# LANHU_DDS_COOKIE=

# 本地数据落盘目录（可选；默认仓库根目录 ./data）
# LANHU_DATA_DIR=./data

# MCP 进程标识（可选）
# MCP_SERVER_NAME=lanhu-mcp-node
# MCP_SERVER_VERSION=0.1.0
