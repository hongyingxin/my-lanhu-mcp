# 复制为 .env 后填写（.env 已被 git 忽略，勿提交）
# cp .env.example .env

# 蓝湖登录 Cookie（必填）
# 浏览器 DevTools → Network → 任意 lanhuapp.com 请求 → 复制 Cookie 请求头
# LANHU_COOKIE=

# DDS 专用 Cookie（预留；当前 server / MCP 不读取，DDS 复用 LANHU_COOKIE；HTTP body 可传 ddsCookie 覆盖）
# LANHU_DDS_COOKIE=

# 本地数据落盘目录（可选；默认仓库根目录 ./data）
# 相对路径锚定 monorepo 仓库根；绝对路径直接用该路径（~ 不会展开）
# LANHU_DATA_DIR=./data
# LANHU_DATA_DIR=/Users/hong/my-text-data

# 是否写入 LANHU_DATA_DIR（可选；默认 true）。false 时 analyze 不落盘、
# slices 仅返回元数据 JSON、原型 analyze 使用系统临时目录（不写 data/）
# LANHU_PERSIST_ARTIFACTS=true

# MCP 进程标识（可选）
# MCP_SERVER_NAME=lanhu-mcp-node
# MCP_SERVER_VERSION=0.1.0
